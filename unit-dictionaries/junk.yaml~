# SI derived units with special names, and the SI base units they are defined
# from, for the Daubee Excel add-in.
#
# Add it from the Unit dictionaries dialog ("Add from URL"):
#   https://psteckler.github.io/daubee/unit-dictionaries/SI-derived-units.yaml
#
# Sources: "The International System of Units (SI)", 9th edition, BIPM, 2019,
# tables 2 and 4; NIST Special Publication 330 (2019).
#
# The units from gram to degree at the start of the file are the built-in
# ones, repeated exactly so that this dictionary works on its own, even if
# the Excel-native groups are switched off. A dictionary may repeat a unit
# that is already known when the definition is the same.
#
# Each derived unit's "expansion" spells it out in base units, so that Check
# and Infer treat, say, volt-ampere and watt as the same unit.
#
# Left out: kelvin and the degree Celsius (temperatures are offsets, not
# factors; Excel-native already has them), and the one-letter symbols C
# (coulomb) and F (farad), which Excel's own CONVERT uses for degrees
# Celsius and Fahrenheit. Write coulomb and farad out; prefixed forms work
# too (mcoulomb, uF is not available, but mfarad is).

weight_and_mass:
  - canonicalName: gram
    aliases: [g, grams]
    prefixable: { metric: [g] }
  - canonicalName: kilogram
    aliases: [kg, kilograms]
    conversion: "1000 gram"

distance:
  - canonicalName: meter
    aliases: [m, meters]
    prefixable: { metric: [m] }

time:
  - canonicalName: second
    aliases: [s, sec, seconds]
    prefixable: { metric: [s, sec] }

force:
  - canonicalName: newton
    aliases: [N, newtons]
    prefixable: { metric: [N] }
    expansion: kg-m/s^2

pressure:
  - canonicalName: pascal
    aliases: [Pa, p, pascals]
    prefixable: { metric: [Pa] }
    expansion: N/m^2

energy:
  - canonicalName: joule
    aliases: [J, joules]
    prefixable: { metric: [J] }
    expansion: kg-m^2/s^2

power:
  - canonicalName: watt
    aliases: [W, w, watts]
    prefixable: { metric: [W] }
    expansion: kg-m^2/s^3

angle:
  - canonicalName: degree
    aliases: [deg, degrees]
  - canonicalName: radian
    aliases: [rad, radians]
    conversion: "57.29577951308232 degree"

si_base_units:
  - canonicalName: ampere
    aliases: [A, amp, amps, amperes]
    prefixable: { metric: [A] }
  - canonicalName: mole
    aliases: [mol, moles]
    prefixable: { metric: [mol] }
  - canonicalName: candela
    aliases: [cd, candelas]
    prefixable: { metric: [cd] }

si_derived_units:
  - canonicalName: steradian
    aliases: [sr, steradians]
  - canonicalName: hertz
    aliases: [Hz]
    prefixable: { metric: [Hz] }
    expansion: s^(-1)
  - canonicalName: coulomb
    aliases: [coulombs]
    prefixable: { metric: [coulomb] }
    expansion: A-s
  - canonicalName: volt
    aliases: [V, volts]
    prefixable: { metric: [V] }
    expansion: kg-m^2/(s^3-A)
  - canonicalName: farad
    aliases: [farads]
    prefixable: { metric: [farad] }
    expansion: s^4-A^2/(kg-m^2)
  - canonicalName: ohm
    aliases: [Ohm, ohms, Ohms]
    prefixable: { metric: [ohm] }
    expansion: kg-m^2/(s^3-A^2)
  - canonicalName: siemens
    aliases: [S]
    prefixable: { metric: [S] }
    expansion: s^3-A^2/(kg-m^2)
  - canonicalName: weber
    aliases: [Wb, webers]
    prefixable: { metric: [Wb] }
    expansion: kg-m^2/(s^2-A)
  - canonicalName: tesla
    aliases: [T, teslas]
    prefixable: { metric: [T] }
    expansion: kg/(s^2-A)
  - canonicalName: henry
    aliases: [H, henrys, henries]
    prefixable: { metric: [H] }
    expansion: kg-m^2/(s^2-A^2)
  - canonicalName: lumen
    aliases: [lm, lumens]
    prefixable: { metric: [lm] }
    expansion: cd-sr
  - canonicalName: lux
    aliases: [lx, luxes]
    prefixable: { metric: [lx] }
    expansion: cd-sr/m^2
  - canonicalName: becquerel
    aliases: [Bq, becquerels]
    prefixable: { metric: [Bq] }
    expansion: s^(-1)
  - canonicalName: gray
    aliases: [Gy, grays]
    prefixable: { metric: [Gy] }
    expansion: m^2/s^2
  - canonicalName: sievert
    aliases: [Sv, sieverts]
    prefixable: { metric: [Sv] }
    expansion: m^2/s^2
  - canonicalName: katal
    aliases: [kat, katals]
    prefixable: { metric: [kat] }
    expansion: mol/s
